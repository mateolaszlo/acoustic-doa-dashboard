# Vite Dev Server Proxy Target (HTTPS Gateway with self-signed SAN cert support)
VITE_BACKEND_HTTPS_URL=https://localhost:3443

# HTTPS for the Vite Dev Server itself (https://localhost:5173/)
# Auto-generates local SAN certificates in ./certs/ when missing; set to false for HTTP-only
VITE_ENABLE_HTTPS=true
VITE_SSL_KEY_PATH=./certs/server.key
VITE_SSL_CERT_PATH=./certs/server.cert
