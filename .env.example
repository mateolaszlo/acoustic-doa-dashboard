# Backend Server Base URL (HTTPS Management / Web Visualizer Gateway)
VITE_API_BASE_URL=https://localhost:3443

# Vite Dev Server Proxy Target (HTTPS Gateway with self-signed SAN cert support)
VITE_BACKEND_HTTPS_URL=https://localhost:3443

# Optional HTTPS for the Vite Dev Server itself (https://localhost:5173/)
# Set to false to keep the dev server on HTTP while still proxying /api to HTTPS
VITE_ENABLE_HTTPS=true
VITE_SSL_KEY_PATH=../acoustic-doa-backend/certs/server.key
VITE_SSL_CERT_PATH=../acoustic-doa-backend/certs/server.cert
